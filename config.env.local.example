# 로컬 개발용 — 이 파일을 config.env.local 로 복사하세요 (Git 제외)
# Mac Homebrew/Postgres.app: 기본 슈퍼유저는 보통 macOS 로그인 이름입니다 (postgres 아님)

DATABASE_URL=postgresql://jhc@127.0.0.1:5432/admin_page
SECRET_KEY=dev-secret-key-change-me
FLASK_ENV=development
FLASK_DEBUG=True

# 이메일 — Gmail API (로컬 발송 테스트, 서버 config.env 와 동일한 GMAIL_* 값 사용)
MAIL_TRANSPORT=gmail_api
MAIL_DEFAULT_SENDER=koreaepilepsy@kes.or.kr
MAIL_REPLY_TO=koreaepilepsy@kes.or.kr
GMAIL_CLIENT_ID=your-client-id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=your-client-secret
GMAIL_REFRESH_TOKEN=your-refresh-token
# 다른 주소로 테스트: GMAIL_TEST_RECIPIENT=your@email.com
