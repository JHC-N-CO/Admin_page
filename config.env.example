# 서버/공통 (프로덕션). 로컬 개발은 config.env.local.example → config.env.local 사용
DATABASE_URL=postgresql://username:password@your-server:5432/jhc_conference_db

# Email — Gmail API (권장, DO SMTP 포트 불필요)
MAIL_TRANSPORT=gmail_api
MAIL_DEFAULT_SENDER=koreaepilepsy@kes.or.kr
MAIL_REPLY_TO=koreaepilepsy@kes.or.kr
GMAIL_CLIENT_ID=your-client-id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=your-client-secret
GMAIL_REFRESH_TOKEN=your-refresh-token
# 최초 1회: Google Cloud OAuth 클라이언트 JSON으로
#   python3 scripts/gmail_oauth_setup.py credentials.json

# Email — SMTP fallback (MAIL_TRANSPORT=smtp 일 때만)
# MAIL_SERVER=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=koreaepilepsy@kes.or.kr
# MAIL_PASSWORD=your_app_password
# MAIL_USE_TLS=True
# MAIL_USE_SSL=False

# Flask Configuration
SECRET_KEY=your-secret-key-here
FLASK_ENV=development
FLASK_DEBUG=True

# File Upload Configuration
MAX_CONTENT_LENGTH=16777216  # 16MB
UPLOAD_FOLDER=uploads
